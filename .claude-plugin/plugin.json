{
  "name": "naive-user",
  "version": "0.2.1",
  "description": "Drive a live web app as a source-blind, naive first-time user and report UX/behavior gaps (bugs, broken expectations, UX surprises, a11y) before deploy. Config-driven, Playwright-MCP powered.",
  "author": { "name": "Kian Alikhani" },
  "homepage": "https://github.com/TechGardenCode/naive-user",
  "repository": "https://github.com/TechGardenCode/naive-user",
  "license": "MIT",
  "keywords": ["qa", "ux-testing", "usability-testing", "exploratory-testing", "playwright", "playwright-mcp", "mcp", "browser-automation", "ai-agent", "naive-user", "claude-code"],
  "commands": "./commands/",
  "skills": "./skills/",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless"]
    }
  }
}
